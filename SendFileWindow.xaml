<Window x:Class="SerialTerminal.SendFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send file" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock Text="File"/>
        <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="100" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center" TextChanged="PathBox_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="InfoText" Opacity="0.7" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Chunk size" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ChunkBox" Width="100" IsEditable="True"
                      ToolTip="Bytes written to the port at once"/>
            <TextBlock Text="bytes" VerticalAlignment="Center" Margin="6,0,24,0"/>
            <TextBlock Text="Delay between chunks" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DelayBox" Width="90" IsEditable="True"
                      ToolTip="Pause after each chunk, for devices that can't keep up"/>
            <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Margin="0,0,0,6"/>
        <TextBlock x:Name="ProgressText" Opacity="0.8" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SendButton" Content="Send" Width="100" IsDefault="True" Click="Send_Click"
                    Style="{DynamicResource AccentButtonStyle}"/>
            <Button x:Name="CloseButton" Content="Close" Width="100" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
