<UserControl x:Class="SerialTerminal.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SerialTerminal"
             xmlns:core="clr-namespace:SerialTerminal.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EnumTextConverter x:Key="EnumText"/>
        <local:NotNullConverter x:Key="NotNull"/>
        <local:BoolToValueConverter x:Key="Not">
            <local:BoolToValueConverter.TrueValue>
                <sys:Boolean>False</sys:Boolean>
            </local:BoolToValueConverter.TrueValue>
            <local:BoolToValueConverter.FalseValue>
                <sys:Boolean>True</sys:Boolean>
            </local:BoolToValueConverter.FalseValue>
        </local:BoolToValueConverter>
        <local:BoolToValueConverter x:Key="WrapToScrollBar"
                                    TrueValue="{x:Static ScrollBarVisibility.Disabled}"
                                    FalseValue="{x:Static ScrollBarVisibility.Auto}"/>
        <local:BoolToValueConverter x:Key="WrapToTextWrapping"
                                    TrueValue="{x:Static TextWrapping.Wrap}"
                                    FalseValue="{x:Static TextWrapping.NoWrap}"/>

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumText}}"/>
        </DataTemplate>

        <!-- Compact terminal rows (the Fluent default item is too tall) -->
        <Style x:Key="TerminalItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TermSelection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TerminalLineTemplate" DataType="{x:Type core:TerminalLine}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Margin="0,0,12,0"
                           Foreground="{DynamicResource TermTimestamp}"
                           Visibility="{Binding DataContext.Main.ShowTimestamps, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                <TextBlock x:Name="Txt" Text="{Binding Text}" Foreground="{DynamicResource TermRx}"
                           TextWrapping="{Binding DataContext.Main.WordWrap, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource WrapToTextWrapping}}"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:LineKind.Tx}">
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TermTx}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:LineKind.Info}">
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TermInfo}"/>
                    <Setter TargetName="Txt" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:LineKind.Error}">
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TermError}"/>
                </DataTrigger>
                <!-- last so it wins over RX/TX colors -->
                <DataTrigger Binding="{Binding Highlight, Converter={StaticResource NotNull}}" Value="True">
                    <Setter TargetName="Txt" Property="Foreground" Value="{Binding Highlight}"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#40808080" Padding="10,4"
                Visibility="{Binding Main.ShowStatusBar, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCountersCommand}"
                        Padding="8,2" Margin="8,0,0,0" ToolTip="Reset byte counters"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Run Text="RX:"/> <Run Text="{Binding RxBytes, Mode=OneWay}"/>
                    <Run Text="   TX:"/> <Run Text="{Binding TxBytes, Mode=OneWay}"/>
                    <Run Text=" bytes"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LogStatus}" Margin="0,0,24,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TermInfo}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Send lines -->
        <ItemsControl x:Name="SendLinesPanel" DockPanel.Dock="Bottom" ItemsSource="{Binding SendLines}" Margin="8,2,8,4"
                      Visibility="{Binding Main.ShowSendBar, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type core:SendLine}">
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Send" Width="80" Margin="6,0,0,0"
                                Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" Width="95" IsEditable="True"
                                  ItemsSource="{Binding DataContext.RepeatIntervals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding RepeatMs, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Repeat interval in milliseconds (minimum 10)"/>
                        <CheckBox DockPanel.Dock="Right" Content="Repeat" IsChecked="{Binding Repeat}" MinWidth="0"
                                  Margin="12,0,6,0" VerticalAlignment="Center" ToolTip="Send periodically while connected"/>
                        <ComboBox DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" SelectedItem="{Binding LineEnding}"
                                  ItemsSource="{Binding DataContext.LineEndings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ToolTip="Line ending appended in text mode"/>
                        <CheckBox DockPanel.Dock="Right" Content="+CRC" IsChecked="{Binding AppendCrc}" IsEnabled="{Binding IsHex}"
                                  MinWidth="0" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Append Modbus CRC16 to HEX data"/>
                        <CheckBox DockPanel.Dock="Right" Content="HEX" IsChecked="{Binding IsHex}" MinWidth="0"
                                  Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Send as hex bytes, e.g. 01 03 00 00 00 0A"/>
                        <TextBox x:Name="SendBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"
                                 PreviewKeyDown="SendBox_PreviewKeyDown"
                                 ToolTip="Enter = send, Up/Down = history"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Macros (shared by all tabs) -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Main.Macros}" Margin="8,6,2,0"
                      Visibility="{Binding Main.ShowMacroBar, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type core:Macro}">
                    <Button Content="{Binding Name}" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.SendMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            MouseRightButtonUp="MacroButton_RightClick"
                            ToolTip="{Binding Data}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Connection bar -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,0"
                   Visibility="{Binding Main.ShowConnectionBar, Converter={StaticResource BoolToVis}}">
            <ComboBox Width="330" Margin="0,0,4,6" ItemsSource="{Binding Main.Ports}" SelectedItem="{Binding SelectedPort}"
                      DisplayMemberPath="Display" IsEnabled="{Binding CanEditSettings}" ToolTip="Port"/>
            <Button Content="⟳" Margin="0,0,12,6" Padding="10,4" Command="{Binding Main.RefreshPortsCommand}" ToolTip="Refresh port list"/>
            <ComboBox Width="120" Margin="0,0,6,6" IsEditable="True" ItemsSource="{Binding BaudRates}"
                      Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanEditSettings}" ToolTip="Baud rate (any value can be typed)"/>
            <ComboBox Width="70" Margin="0,0,6,6" ItemsSource="{Binding DataBitsValues}" SelectedItem="{Binding DataBits}"
                      IsEnabled="{Binding CanEditSettings}" ToolTip="Data bits"/>
            <ComboBox Width="95" Margin="0,0,6,6" ItemsSource="{Binding ParityValues}" SelectedItem="{Binding Parity}"
                      IsEnabled="{Binding CanEditSettings}" ToolTip="Parity"/>
            <ComboBox Width="75" Margin="0,0,6,6" ItemsSource="{Binding StopBitsValues}" SelectedItem="{Binding StopBits}"
                      ItemTemplate="{StaticResource EnumItem}" IsEnabled="{Binding CanEditSettings}" ToolTip="Stop bits"/>
            <ComboBox Width="170" Margin="0,0,12,6" ItemsSource="{Binding HandshakeValues}" SelectedItem="{Binding Handshake}"
                      IsEnabled="{Binding CanEditSettings}" ToolTip="Flow control"/>
            <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Width="110" Margin="0,0,12,6"/>
            <CheckBox Content="DTR" IsChecked="{Binding Dtr}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="RTS" IsChecked="{Binding Rts}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="Auto-reconnect" IsChecked="{Binding AutoReconnect}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- Display bar -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,0"
                   Visibility="{Binding Main.ShowDisplayBar, Converter={StaticResource BoolToVis}}">
            <ComboBox Width="140" Margin="0,0,12,6" ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}"
                      ItemTemplate="{StaticResource EnumItem}" ToolTip="Display mode"/>
            <CheckBox Content="Timestamps" IsChecked="{Binding Main.ShowTimestamps}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="Word wrap" IsChecked="{Binding Main.WordWrap}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="Auto-scroll" IsChecked="{Binding Main.AutoScroll}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="Dark" IsChecked="{Binding Main.IsDarkTheme}" MinWidth="0" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <CheckBox Content="Graph" IsChecked="{Binding ShowGraph}" MinWidth="0" Margin="0,0,16,6" VerticalAlignment="Center"
                      ToolTip="Plot numbers from received text lines"/>
            <Button Content="Highlight..." Command="{Binding Main.EditHighlightsCommand}" Margin="0,0,6,6"
                    ToolTip="Color lines that contain keywords"/>
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,6,6"/>
            <Button Content="Save as..." Command="{Binding SaveAsCommand}" Margin="0,0,6,6"/>
            <Button Content="Send file..." Command="{Binding SendFileCommand}" Margin="0,0,6,6"/>
        </WrapPanel>

        <!-- Filter and log bar -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,6"
                   Visibility="{Binding Main.ShowFilterBar, Converter={StaticResource BoolToVis}}">
            <CheckBox Content="Filter" IsChecked="{Binding FilterEnabled}" MinWidth="0" Margin="0,0,20,6"
                      VerticalAlignment="Center" ToolTip="Show only lines containing the text (Ctrl+F)"/>
            <TextBox x:Name="FilterBox" Width="260" Margin="-12,0,20,6" VerticalContentAlignment="Center"
                     Visibility="{Binding FilterEnabled, Converter={StaticResource BoolToVis}}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     ToolTip="Text to look for (not case sensitive)"/>
            <Button Content="{Binding LogButtonText}" Command="{Binding ToggleLogCommand}" Width="100" Margin="0,0,6,6"
                    ToolTip="Write to file while monitoring (Ctrl+L)"/>
            <Button Content="Log folder..." Command="{Binding Main.ChooseLogFolderCommand}" Margin="0,0,6,6" ToolTip="{Binding Main.LogFolder}"/>
            <Button Content="Open folder" Command="{Binding Main.OpenLogFolderCommand}" Margin="0,0,6,6" ToolTip="{Binding Main.LogFolder}"/>
        </WrapPanel>

        <!-- Terminal + optional graph -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="GraphRow" Height="0"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="Terminal" Grid.Row="0" ItemsSource="{Binding Lines}" SelectionMode="Extended"
                     Background="{DynamicResource TermBackground}" BorderThickness="0" Padding="0,4"
                     FontFamily="Cascadia Mono, Consolas" FontSize="{Binding Main.FontSize}"
                     ItemContainerStyle="{StaticResource TerminalItem}"
                     ItemTemplate="{StaticResource TerminalLineTemplate}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="{Binding Main.WordWrap, Converter={StaticResource WrapToScrollBar}}"
                     PreviewMouseWheel="Terminal_PreviewMouseWheel"/>

            <GridSplitter x:Name="GraphSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="#30808080" Visibility="Collapsed"/>

            <DockPanel x:Name="GraphPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource TermBackground}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
                    <TextBlock Text="Graph" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Width="90" ItemsSource="{Binding GraphWindows}" SelectedItem="{Binding GraphWindowSeconds}"
                              ItemStringFormat="{}{0} s" ToolTip="Visible time window"/>
                    <Button Content="Clear" Command="{Binding ClearGraphCommand}" Margin="8,0,20,0"/>
                    <CheckBox Content="Auto Y" IsChecked="{Binding GraphAutoScale}" MinWidth="0" VerticalAlignment="Center"
                              ToolTip="Y range follows the data; uncheck to set Min/Max manually"/>
                    <CheckBox Content="Include 0" IsChecked="{Binding GraphIncludeZero}" MinWidth="0" Margin="10,0,0,0"
                              VerticalAlignment="Center" IsEnabled="{Binding GraphAutoScale}"
                              ToolTip="Keep the zero line visible in auto mode"/>
                    <TextBlock Text="Min" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBox Width="80" Text="{Binding GraphYMin}" VerticalContentAlignment="Center"
                             IsEnabled="{Binding GraphAutoScale, Converter={StaticResource Not}}"
                             KeyDown="GraphRange_KeyDown"/>
                    <TextBlock Text="Max" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Width="80" Text="{Binding GraphYMax}" VerticalContentAlignment="Center"
                             IsEnabled="{Binding GraphAutoScale, Converter={StaticResource Not}}"
                             KeyDown="GraphRange_KeyDown"/>
                </StackPanel>
                <local:ChartControl Data="{Binding Graph}" WindowSeconds="{Binding GraphWindowSeconds}"
                                    AutoScale="{Binding GraphAutoScale}" IncludeZero="{Binding GraphIncludeZero}"
                                    YMin="{Binding GraphYMin}" YMax="{Binding GraphYMax}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
