<Window x:Class="SerialTerminal.HighlightRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialTerminal"
        xmlns:core="clr-namespace:SerialTerminal.Core"
        Title="Highlight rules" Width="680" Height="460" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:ColorNameToBrushConverter x:Key="ColorBrush"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"
                   Text="Received and sent lines that contain the text are shown in the rule's color. The first matching rule wins."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add rule" Width="100" Click="Add_Click"/>
            <Button Content="Close" Width="100" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RulesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:HighlightRule}">
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" MinWidth="0"
                                      VerticalAlignment="Center" ToolTip="Enabled"/>
                            <Button DockPanel.Dock="Right" Content="✕" Width="36" Margin="6,0,0,0"
                                    Click="Remove_Click" ToolTip="Remove rule"/>
                            <ComboBox DockPanel.Dock="Right" Width="140" Margin="6,0,0,0"
                                      ItemsSource="{x:Static core:HighlightRule.ColorNames}" SelectedItem="{Binding Color}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding Converter={StaticResource ColorBrush}}"/>
                                            <TextBlock Text="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox DockPanel.Dock="Right" Content="Match case" IsChecked="{Binding MatchCase}"
                                      MinWidth="0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding Brush}"
                                     FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"
                                     ToolTip="Text to look for"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
