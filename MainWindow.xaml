<Window x:Class="SerialTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialTerminal"
        xmlns:core="clr-namespace:SerialTerminal.Core"
        Title="Serial Terminal" Icon="/Assets/app.ico" Height="800" Width="1280" MinWidth="760" MinHeight="460"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddSessionCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseSessionCommand}" CommandParameter="{Binding SelectedSession}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SelectedSession.SaveAsCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding SelectedSession.ToggleLogCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SelectedSession.ToggleFilterCommand}"/>
        <KeyBinding Key="F5" Command="{Binding SelectedSession.ToggleConnectionCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EqualsConverter x:Key="Equals"/>

        <Style x:Key="TabHeader" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="12,6,6,6" Margin="0,0,2,0" CornerRadius="6,6,0,0"
                                Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TermTx}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New tab" InputGestureText="Ctrl+T" Command="{Binding AddSessionCommand}"/>
                <MenuItem Header="_Close tab" InputGestureText="Ctrl+W" Command="{Binding CloseSessionCommand}"
                          CommandParameter="{Binding SelectedSession}"/>
                <Separator/>
                <MenuItem Header="_Save output as..." InputGestureText="Ctrl+S" Command="{Binding SelectedSession.SaveAsCommand}"/>
                <MenuItem Header="{Binding SelectedSession.LogButtonText}" InputGestureText="Ctrl+L"
                          Command="{Binding SelectedSession.ToggleLogCommand}"/>
                <MenuItem Header="Log _folder..." Command="{Binding ChooseLogFolderCommand}"/>
                <MenuItem Header="_Open log folder" Command="{Binding OpenLogFolderCommand}"/>
                <Separator/>
                <MenuItem Header="Send f_ile..." Command="{Binding SelectedSession.SendFileCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="ApplicationCommands.Copy"/>
                <MenuItem Command="ApplicationCommands.SelectAll"/>
                <Separator/>
                <MenuItem Header="_Filter" InputGestureText="Ctrl+F" IsCheckable="True"
                          IsChecked="{Binding SelectedSession.FilterEnabled}"/>
                <MenuItem Header="C_lear output" Command="{Binding SelectedSession.ClearCommand}"/>
                <MenuItem Header="_Reset byte counters" Command="{Binding SelectedSession.ResetCountersCommand}"/>
            </MenuItem>
            <MenuItem Header="_Connection">
                <MenuItem Header="{Binding SelectedSession.ConnectButtonText}" InputGestureText="F5"
                          Command="{Binding SelectedSession.ToggleConnectionCommand}"/>
                <MenuItem Header="_Refresh ports" Command="{Binding RefreshPortsCommand}"/>
                <Separator/>
                <MenuItem Header="_DTR" IsCheckable="True" IsChecked="{Binding SelectedSession.Dtr}"/>
                <MenuItem Header="_RTS" IsCheckable="True" IsChecked="{Binding SelectedSession.Rts}"/>
                <MenuItem Header="_Auto-reconnect" IsCheckable="True" IsChecked="{Binding SelectedSession.AutoReconnect}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toolbars">
                    <MenuItem Header="_Connection bar" IsCheckable="True" IsChecked="{Binding ShowConnectionBar}"/>
                    <MenuItem Header="_Display bar" IsCheckable="True" IsChecked="{Binding ShowDisplayBar}"/>
                    <MenuItem Header="_Filter and log bar" IsCheckable="True" IsChecked="{Binding ShowFilterBar}"/>
                    <MenuItem Header="_Macro buttons" IsCheckable="True" IsChecked="{Binding ShowMacroBar}"/>
                    <MenuItem Header="S_end lines" IsCheckable="True" IsChecked="{Binding ShowSendBar}"/>
                    <MenuItem Header="S_tatus bar" IsCheckable="True" IsChecked="{Binding ShowStatusBar}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Display _mode">
                    <MenuItem Header="_Text" Command="{Binding SelectedSession.SetDisplayModeCommand}" CommandParameter="{x:Static core:DisplayMode.Text}"
                              IsChecked="{Binding SelectedSession.DisplayMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:DisplayMode.Text}}"/>
                    <MenuItem Header="_HEX" Command="{Binding SelectedSession.SetDisplayModeCommand}" CommandParameter="{x:Static core:DisplayMode.Hex}"
                              IsChecked="{Binding SelectedSession.DisplayMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:DisplayMode.Hex}}"/>
                    <MenuItem Header="HEX + _ASCII" Command="{Binding SelectedSession.SetDisplayModeCommand}" CommandParameter="{x:Static core:DisplayMode.HexAscii}"
                              IsChecked="{Binding SelectedSession.DisplayMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:DisplayMode.HexAscii}}"/>
                    <MenuItem Header="_Modbus RTU" Command="{Binding SelectedSession.SetDisplayModeCommand}" CommandParameter="{x:Static core:DisplayMode.ModbusRtu}"
                              IsChecked="{Binding SelectedSession.DisplayMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:DisplayMode.ModbusRtu}}"/>
                </MenuItem>
                <MenuItem Header="T_imestamps" IsCheckable="True" IsChecked="{Binding ShowTimestamps}"/>
                <MenuItem Header="_Word wrap" IsCheckable="True" IsChecked="{Binding WordWrap}"/>
                <MenuItem Header="_Auto-scroll" IsCheckable="True" IsChecked="{Binding AutoScroll}"/>
                <MenuItem Header="_Graph" IsCheckable="True" IsChecked="{Binding SelectedSession.ShowGraph}"/>
                <MenuItem Header="_Dark theme" IsCheckable="True" IsChecked="{Binding IsDarkTheme}"/>
                <Separator/>
                <MenuItem Header="Zoom _in" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="Zoom _out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                <MenuItem Header="_Reset zoom" InputGestureText="Ctrl+0" Command="{Binding ZoomResetCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Highlight rules..." Command="{Binding EditHighlightsCommand}"/>
                <MenuItem Header="Edit _macro" ItemsSource="{Binding Macros}" DisplayMemberPath="Name" Click="EditMacroMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Project _website" Command="{Binding OpenUrlCommand}"
                          CommandParameter="https://kod447.github.io/serial-terminal/"/>
                <MenuItem Header="Source code and _issues (GitHub)" Command="{Binding OpenUrlCommand}"
                          CommandParameter="https://github.com/kod47/serial-terminal"/>
                <Separator/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Tab strip -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,0">
            <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                     ItemContainerStyle="{StaticResource TabHeader}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SessionViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#808080"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Content="✕" Margin="8,0,0,0" Padding="6,0" MinWidth="0" MinHeight="0" FontSize="11"
                                    Background="Transparent" BorderThickness="0" ToolTip="Close tab"
                                    Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                <Setter TargetName="Dot" Property="Fill" Value="#30A46C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Waiting">
                                <Setter TargetName="Dot" Property="Fill" Value="#F76B15"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="+" DockPanel.Dock="Left" HorizontalAlignment="Left" Padding="12,2" Margin="4,0,0,0"
                    VerticalAlignment="Center" Command="{Binding AddSessionCommand}" ToolTip="New tab (Ctrl+T)"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="#40808080"/>

        <!-- All tabs stay alive; only the active one is visible -->
        <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SessionViewModel}">
                    <local:SessionView Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
